{
  "cli": {
    "version": ">= 16.12.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
        "android": {
          "buildType": "apk"
        },
      "env": {
        "API_URL": "https://presenca-plus.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
